# Configuración Central del Agente Autónomo Local JEV

# 1. Configuración de Modelos LLM (Híbrido / Cloud / Local)
GEMINI_API_KEY=tu_clave_gemini_aqui
GOOGLE_API_KEY=tu_clave_gemini_aqui
OPENROUTER_API_KEY=sk-or-v1-tu_clave_openrouter_aqui

# Modelos y Enrutamiento
JEV_LLM_PROVIDER=gemini
JEV_THINKER_MODEL=gemini-3.8-flash
JEV_EXECUTOR_MODEL=qwen2.5-coder:latest
FCC_MODEL=open_router/anthropic/claude-3.5-sonnet
FCC_PORT=8082

# Runtimes Locales
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# 2. Control Remoto Seguro vía Telegram Bot (Long Polling)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
ALLOWED_TELEGRAM_USER_ID=123456789
